    "actions": [
      {
        "type": "award.stamp",
        "payload": {
          "stampId": "w05-carnet"
        }
      },
      {
        "type": "create.file",
        "payload": {
          "path": "/Mes Documents/Carnet de voyage 2005.txt",
          "content": "CARNET DE VOYAGE — 2005\n\nMessagerie instantanée et Web consultés depuis la même machine.\nComparez avec le modem de 1998 : la même page arrive bien plus vite.\n"
        }
      },
      {
        "type": "play.sound",
        "payload": {
          "event": "notification"
        }
      },
      {
        "type": "show.notification",
        "payload": {
          "title": "Nouveau document",
          "body": "« Carnet de voyage 2005.txt » vient d'apparaître dans Mes Documents."
        }
      }
    ],
    "once": true
  },
