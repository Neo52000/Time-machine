[
  {
    "id": "welcome-1998",
    "eras": ["1998"],
    "when": [
      {
        "event": "era.loaded"
      }
    ],
    "actions": [
      {
        "type": "show.notification",
        "payload": {
          "title": "Bienvenue en 1998",
          "body": "Votre PC est prêt. Dans le Time Browser, seuls les sites en ligne à la date de la machine répondent."
        }
      }
    ],
    "once": true
  },
  {
    "id": "not-yet-online",
    "eras": ["1992", "1998", "2005"],
    "when": [
      {
        "event": "site.visited",
        "match": {
          "reason": "not-yet-online"
        }
      }
    ],
    "actions": [
      {
        "type": "show.notification",
        "payload": {
          "title": "Pas encore en ligne",
          "body": "{domain} n'existe pas encore à la date de cette machine. Choisissez une époque plus récente pour le visiter."
        }
      }
    ],
    "once": true
  },
  {
    "id": "history-note",
    "eras": ["1998", "2005"],
    "when": [
      {
        "event": "event.viewed"
      }
    ],
    "actions": [
      {
        "type": "create.file",
        "payload": {
          "path": "/Mes Documents/Note d'histoire.txt",
          "content": "NOTE D'HISTOIRE\n\nVu dans le Time Browser : {date} — {title}.\n\nLes dates du Time Web ne sont pas inventées : chacune cite ses sources.\nRetrouvez cet événement, ses sources et ce qui était en ligne à la même\népoque au Musée (page d'accueil › Musée).\n"
        }
      },
      {
        "type": "show.notification",
        "payload": {
          "title": "Nouveau document",
          "body": "« Note d'histoire.txt » vient d'apparaître dans Mes Documents."
        }
      }
    ],
    "once": true
  },
  {
    "id": "explorer-1998",
    "eras": ["1998"],
    "when": [
      {
        "event": "site.visited"
      },
      {
        "event": "search.executed"
      },
      {
        "event": "file.opened"
      }
    ],
    "actions": [
      {
        "type": "award.stamp",
        "payload": {
          "stampId": "w98-carnet"
        }
      },
      {
        "type": "set.flag",
        "payload": {
          "flag": "explorer-1998"
        }
      },
      {
        "type": "create.file",
        "payload": {
          "path": "/Mes Documents/Carnet de voyage.txt",
          "content": "CARNET DE VOYAGE — 1998\n\nVous avez visité un site, lancé une recherche et ouvert un document.\nLe Web de cette machine ne contient que ce qui existait à sa date :\nessayez la même recherche sur la machine de 2005 et comparez.\n"
        }
      },
      {
        "type": "show.notification",
        "payload": {
          "title": "Nouveau document",
          "body": "« Carnet de voyage.txt » vient d'apparaître dans Mes Documents."
        }
      }
    ],
    "once": true
  },
  {
